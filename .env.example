# 複製成 .env 再修改：cp .env.example .env
# 沒有 .env（或其中沒有 EBO_JWT_SIGNING_KEY）時 docker compose 會拒絕執行；下面的值只供開發。
# 對外開放前務必更換 EBO_JWT_SIGNING_KEY（至少 32 個字元）與資料庫密碼（EBO_DB_PASSWORD、EBO_DB_ROOT_PASSWORD）。
EBO_JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef

# 資料庫帳密只在第一次建立 mysql volume 時生效；之後要改得先 docker compose down -v（會刪存檔）。
# 密碼不要含分號，否則連線字串會被截斷；含 $ 時寫成 $$，或整個值用單引號包起來，否則會被 compose 當成變數。
EBO_DB_USER=ebo
EBO_DB_PASSWORD=ebo_dev
EBO_DB_ROOT_PASSWORD=root_dev

# 埠：MySQL 只綁本機 127.0.0.1，網頁對外
EBO_MYSQL_PORT=3306
EBO_WEB_PORT=8080

# 只有 NAS 用：TUNNEL_TOKEN（Cloudflare Tunnel）由 deploy-nas.sh 從本機 .env.nas.local 寫進 NAS 的 .env，不用手動加；
# 有值時才會啟用 tunnel profile。本機開發不用設。
