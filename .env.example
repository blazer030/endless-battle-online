# 複製成 .env 再修改：cp .env.example .env
# 對外開放前務必更換 EBO_JWT_SIGNING_KEY（至少 32 個字元）與資料庫密碼。
EBO_JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef

# 資料庫帳密只在第一次建立 mysql volume 時生效；之後要改得先 docker compose down -v（會刪存檔）。
# 密碼不要含分號，否則連線字串會被截斷。
EBO_DB_USER=ebo
EBO_DB_PASSWORD=ebo_dev
EBO_DB_ROOT_PASSWORD=root_dev

# 對外的埠
EBO_MYSQL_PORT=3306
EBO_WEB_PORT=8080
